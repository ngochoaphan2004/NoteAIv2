# NoteAI.v2 Environment Configuration

# Database (PostgreSQL 16 on VPS Port 5432 — native install, không phải Docker)
DATABASE_URL=postgresql://noteai:noteai_secret_password@localhost:5432/noteai_pkm

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=noteai_knowledge

# Cloud LLM API (Google Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
# Cấu hình danh sách mô hình (tự động chuyển giao khi chạm ngưỡng Rate Limit / Quota)
LLM_MODEL=gemini-1.5-flash
LLM_MODELS=gemini-1.5-flash,gemini-2.0-flash,gemini-1.5-flash-8b,gemini-1.5-pro

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CONTENT_DIR=../content
WATCHDOG_ENABLED=true
