# NoteAI.v2 Environment Configuration

# Database (PostgreSQL 16 on Host Port 5433)
DATABASE_URL=postgresql://noteai:noteai_secret_password@localhost:5433/noteai_pkm

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=noteai_knowledge

# Cloud LLM API (Google Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CONTENT_DIR=../content
WATCHDOG_ENABLED=true
