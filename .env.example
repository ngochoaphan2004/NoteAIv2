# ==============================================================================
# NOTEAI.V2 - UNIFIED ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cơ Sở Dữ Liệu Quan Hệ (PostgreSQL 16)
# ------------------------------------------------------------------------------
# VPS Native (không Docker): PostgreSQL cài thẳng trên máy chủ → port 5432 tiêu chuẩn
# Docker Compose (local dev): ánh xạ host 127.0.0.1:5433 → container 5432 (tránh xung đột CVAT)
POSTGRES_USER=noteai
POSTGRES_PASSWORD=noteai_secret_password
POSTGRES_DB=noteai_pkm
# Đặt theo môi trường: VPS native=5432 | Docker local=5433
POSTGRES_PORT=5432
DATABASE_URL=postgresql://noteai:noteai_secret_password@localhost:5432/noteai_pkm

# ------------------------------------------------------------------------------
# 2. Cơ Sở Dữ Liệu Vector (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=noteai_knowledge

# ------------------------------------------------------------------------------
# 3. Cloud LLM Inference Engine (Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
# Điền API Key của bạn vào một trong hai biến dưới đây:
GEMINI_API_KEY=
OPENAI_API_KEY=

# Lựa chọn provider: "gemini" hoặc "openai"
LLM_PROVIDER=gemini
# Danh sách các mô hình ưu tiên (tự động chuyển giao sang mô hình tiếp theo nếu chạm Rate Limit 429)
LLM_MODEL=gemini-1.5-flash
LLM_MODELS=gemini-1.5-flash,gemini-2.0-flash,gemini-1.5-flash-8b,gemini-1.5-pro

# ------------------------------------------------------------------------------
# 4. Cấu Hình Cổng Dịch Vụ Máy Chủ
# ------------------------------------------------------------------------------
FASTAPI_PORT=8000
FRONTEND_PORT=5173
QUARTZ_PORT=8088

# ------------------------------------------------------------------------------
# 5. Cấu Hình Ứng Dụng & Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=development
CONTENT_DIR=./content
WATCHDOG_ENABLED=true
